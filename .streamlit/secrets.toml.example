# Copy this file to `.streamlit/secrets.toml` and fill in your own values.
# `secrets.toml` is git-ignored and must never be committed.
#
# On Streamlit Community Cloud, paste the same keys into
# App settings -> Secrets instead of committing a file.

# Hugging Face repositories holding the fine-tuned weights.
BERT_REPO_ID        = "your-username/FYP-BERT"
BERT_CRF_REPO_ID    = "your-username/FYP-BERT-CRF"
ROBERTA_CRF_REPO_ID = "your-username/FYP-RoBERTa-CRF"
LSTM_CRF_REPO_ID    = "your-username/FYP-LSTM-CRF"

# Access token with read scope. Only required for private repositories;
# leave it out entirely if your model repositories are public.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN = "hf_your_read_only_token_here"
